{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "asaba-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "asaba-nextjs", "run", "dev"],
      "port": 3000
    },
    {
      "name": "beacon-mobile",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd beacon-mobile && exec \"$HOME/flutter/bin/flutter\" run -d web-server --web-hostname=127.0.0.1 --web-port=8080"
      ],
      "port": 8080
    }
  ]
}
