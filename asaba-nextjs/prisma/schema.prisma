model ConfigAdr {
  id              Int     @id @default(autoincrement())
  id_logger       Int
  job_name        String  @db.VarChar(225)
  prisma_cons     Float   @db.Float
  ts_high         Float   @db.Float
  /// DOUBLE, bukan FLOAT: koordinat UTM butuh 9-10 digit signifikan sedangkan
  /// single-precision hanya ~7, sehingga northing hemisfer selatan meleset
  /// sampai ratusan milimeter. coor_x = Northing, coor_y = Easting.
  coor_x          Float
  coor_y          Float
  coor_z          Float
  step_record     Int
  retries         Int
  cycle_time      Int
  /// Mode AutoTracking: true = menyapu mencari prisma di tiap target (`*SJ`),
  /// false = langsung putar ke sudut rekaman lalu ukur.
  ///
  /// Disimpan — beda dari SearchArea dan trackEvery yang sengaja tidak — karena
  /// nilainya bertahan di EEPROM instrumen DAN selalu ikut di snapshot ack
  /// konfigurasi, jadi bisa dicocokkan, bukan ditebak.
  auto_search     Boolean @default(true)
  /// Rentang sapuan (`SearchArea`) dan jadwal AutoTracking (`trackEvery`),
  /// dicatat sebagai "terakhir dikirim" — bukan bukti keadaan instrumen.
  ///
  /// Keduanya tetap dikirim ulang tiap kali Simpan ditekan walau kolomnya tidak
  /// disentuh: PowerOn menimpa jendela sapuan AKTIF di instrumen dengan 7° yang
  /// ter-hardcode, dan jadwal tidak pernah dilaporkan balik sama sekali. Jangan
  /// pakai kolom ini untuk melewatkan pengiriman; lihat migrasi 009.
  ///
  /// FLOAT, bukan INT: sudut sahnya kelipatan 1,5 derajat.
  search_area_hor Float   @default(15) @db.Float
  search_area_ver Float   @default(15) @db.Float
  track_every     Int     @default(0)
  /// Konfigurasi RTS bersifat per-site, bukan per-logger: satu unit RTS bisa
  /// dipakai di beberapa site dengan job name dan titik origin yang berbeda.
  ///
  /// Catatan: coor_x/y/z adalah origin RTS yang DIKIRIM KE PERANGKAT (coor_x =
  /// Northing, coor_y = Easting — penamaannya menyesatkan). Nilai yang sama
  /// juga ada di t_site.rts_n/rts_e/rts_z yang dipakai menghitung deformasi.
  /// Keduanya bisa melenceng; lihat catatan di migration 005.
  site            String  @db.VarChar(50)

  @@unique([site])
  @@map("config_adr")
}

