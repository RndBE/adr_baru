/// Master data site (area pemantauan).
/// Menggantikan percabangan `if (site === 'ccp')` yang sebelumnya di-hardcode.
/// `slug` harus sama persis dengan nilai kolom `log_kontrol.site`.
model Site {
  id          Int    @id @default(autoincrement())
  slug        String @unique @db.VarChar(50)
  nama        String @db.VarChar(100)
  badge_label String @db.VarChar(20)
  badge_color String @db.VarChar(20)

  // Ambang status pergeseran (mm) — batas atas tiap level
  geser_normal_max  Float
  geser_waspada_max Float
  geser_siaga_max   Float

  // Ambang status kecepatan (mm/hari) — batas bawah tiap level
  laju_waspada_min Float
  laju_siaga_min   Float
  laju_awas_min    Float

  // Koordinat referensi RTS (UTM). Null = belum dikalibrasi.
  rts_e Float?
  rts_n Float?
  rts_z Float?

  // Proyeksi UTM untuk konversi ke lat/lng
  utm_zone  Int     @default(50)
  utm_north Boolean @default(true)

  // Tampilan peta. Null = belum dikalibrasi.
  map_lat  Float?
  map_lng  Float?
  map_zoom Int    @default(16)

  /// Base map (ortofoto) untuk lantai scene Visualisasi 3D. Lihat
  /// prisma/migrations/014_basemap_site.sql. Null = site ini tidak punya
  /// ortofoto; halaman 3D-nya cuma tidak menggambar lantai.
  ///
  /// Kotak batasnya dalam METER UTM, zona yang sama dengan utm_zone/utm_north
  /// di atas — sengaja tidak diulang di sini supaya tidak bisa berbeda.
  /// Gambarnya north-up tanpa rotasi: tepi gambar = tepi kotak.
  basemap_url        String? @db.VarChar(255)
  /// PNG 1-bit: putih = bagian bergambar, hitam = tepi kosong ortofoto.
  /// Terpisah dari gambarnya karena JPEG tidak punya alfa dan PNG berwarna
  /// ber-alfa sepuluh kali lebih besar.
  basemap_nodata_url String? @db.VarChar(255)
  basemap_min_e      Float?
  basemap_max_e      Float?
  basemap_min_n      Float?
  basemap_max_n      Float?
  /// Elevasi bidang ortofoto, meter. Null = turunkan dari data (prisma
  /// terendah) — yang berpindah-pindah tiap sesi, jadi isi kolom ini begitu
  /// elevasi tanahnya disurvei.
  basemap_z          Float?

  // Rotasi koordinat. Null = tidak ada koreksi rotasi untuk site ini.
  rotasi_deg Float?
  pivot_e    Float?
  pivot_n    Float?
  ukur_e     Float?
  ukur_n     Float?
  pivot_lat  Float?
  pivot_lng  Float?
  ukur_lat   Float?
  ukur_lng   Float?

  /// Logger (unit RTS) yang melayani site ini — SATU-SATUNYA sumber kebenaran
  /// relasi site↔logger.
  ///
  /// Satu kolom berarti satu site tidak bisa punya lebih dari satu logger.
  /// Tidak diberi kunci unik, karena satu logger memang boleh melayani banyak
  /// site — 30002 melayani ccp dan viewpoint sekaligus.
  ///
  /// Isinya KODE logger (`t_logger.id_logger`, mis. "30002"), bukan primary key
  /// `t_logger.id`. Tipenya menyamai tabel masternya; config_adr dan t_prisma
  /// menyimpan kode yang sama sebagai INT.
  ///
  /// Null selama operator belum memilihnya. Site memang dibuat lebih dulu, baru
  /// loggernya ditentukan.
  id_logger String? @db.VarChar(10)

  /// Dihitung otomatis oleh API: true bila rts_* dan map_* sudah terisi.
  terkalibrasi Boolean @default(false)
  /// Ditandai manual: koordinat/ambang site ini masih nilai contoh, bukan hasil
  /// survei. Terpisah dari `terkalibrasi` karena field yang terisi lengkap tapi
  /// isinya karangan tetap harus memunculkan peringatan.
  data_dummy   Boolean @default(false)
  aktif        Boolean @default(true)
  urutan       Int     @default(0)
  catatan      String? @db.Text

  @@index([id_logger])
  @@map("t_site")
}

/// Keadaan peringatan per prisma, bertahan antar siklus.
/// Tabelnya dibuat oleh prisma/migrations/011_peringatan_pergeseran.sql, yang
/// BELUM dijalankan di basis data mana pun. Sampai itu dilakukan, seluruh
/// kueri ke model ini akan gagal — dan evaluasi-siklus.ts memang menelan
/// kegagalannya, karena peringatan tidak boleh menjatuhkan jalur ingestion.
model StatusPrisma {
  site      String @db.VarChar(50)
  id_prisma String @db.VarChar(20)

  /// Tingkat yang sudah diakui, bukan yang barusan terukur.
  tingkat       String  @default("Normal") @db.VarChar(10)
  /// Tingkat yang menunggu konfirmasi, dan berapa siklus beruntun ia terlihat.
  tingkat_calon String? @db.VarChar(10)
  hitung_calon  Int     @default(0) @db.UnsignedTinyInt

  /// Pergeseran linier 2D terhadap acuan R0, dalam mm.
  nilai_mm        Float?    @db.Double
  siklus_terakhir String?   @db.VarChar(20)
  /// Dasar jeda antar pesan — waktu dinding, bukan hitungan siklus.
  kirim_terakhir  DateTime? @db.DateTime(0)
  /// Siklus beruntun prisma ini gagal ditembak (N1/E1/Z1 semuanya nol).
  gagal_beruntun  Int       @default(0) @db.UnsignedSmallInt

  @@id([site, id_prisma])
  @@map("status_prisma")
}

/// Riwayat perubahan tingkat yang SUDAH terkonfirmasi. Calon yang gugur di
/// tengah tidak masuk sini.
model LogPeringatan {
  id        Int      @id @default(autoincrement())
  site      String   @db.VarChar(50)
  id_prisma String   @db.VarChar(20)
  /// Siklus pemicunya — log_kontrol.id_log.
  id_log    String   @db.VarChar(20)
  dari      String   @db.VarChar(10)
  ke        String   @db.VarChar(10)
  nilai_mm  Float    @db.Double
  waktu     DateTime @db.DateTime(0)
  /// Membedakan "tidak ada peringatan" dari "peringatan gagal berangkat".
  terkirim  Boolean  @default(false)
  galat     String?  @db.VarChar(255)

  @@index([site, waktu], map: "log_peringatan_site_waktu_idx")
  @@map("log_peringatan")
}
