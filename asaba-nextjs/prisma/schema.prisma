model LogKontrol {
  id_log    String   @id @db.VarChar(20)
  id_logger String   @db.VarChar(15)
  prisma    String   @db.VarChar(20)
  datetime  DateTime @db.DateTime(0)
  r0        Int
  site      String?  @default("ccp") @db.VarChar(225)

  @@map("log_kontrol")
}

model StatusKontrol {
  id             Int      @id @default(autoincrement())
  id_logger      String   @db.VarChar(25)
  status_kontrol Int
  session_id     String   @db.VarChar(255)
  waktu          DateTime @db.Date

  @@map("status_kontrol")
}

model SetTempkontrol {
  id_set           Int      @id @default(autoincrement())
  id_logger        Int
  status           Int
  status_manual    Int
  status_operation String   @db.VarChar(20)
  sensor_kontrol   String   @db.VarChar(25)
  datetime         DateTime @db.DateTime(0)

  @@map("set_tempkontrol")
}

model LogSiaga {
  id        Int    @id @default(autoincrement())
  id_logger String @db.VarChar(15)
  nilai     Float  @db.Float
