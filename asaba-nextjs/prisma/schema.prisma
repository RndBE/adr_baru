}

/// Jejak perintah yang dikirim ke alat lewat MQTT. Ditulis di satu tempat —
/// publishMqtt() — supaya tidak ada jalur perintah yang luput dari catatan.
/// Lihat prisma/migrations/013_log_aktivitas.sql.
model LogAktivitas {
  id        Int      @id @default(autoincrement())
  id_logger String   @db.VarChar(15)
  /// Nama perintah pada payload, mis. "measure_fs", "auto_search", "power_on".
  perintah  String   @db.VarChar(64)
  payload   String?  @db.Text
  /// Apakah publish MQTT-nya berhasil. Perintah yang gagal terkirim tetap
  /// dicatat: justru itu yang perlu terlihat saat alat tidak merespons.
  terkirim  Boolean  @default(false)
  /// Jam dinding, bukan UTC — seperti seluruh kolom waktu di basis data ini.
  waktu     DateTime @db.DateTime(0)

  @@index([id_logger, waktu], map: "log_aktivitas_logger_waktu_idx")
  @@map("log_aktivitas")
}

