// =============================================
// CONTROL & MONITORING
// =============================================

model LogKontrol {
  id_log    String   @id @db.VarChar(20)
  id_logger String   @db.VarChar(15)
  prisma    String   @db.VarChar(20)
  datetime  DateTime
  r0        Int      @default(0)
  site      String?  @default("ccp") @db.VarChar(225)

  @@map("log_kontrol")
}

model StatusKontrol {
  id             Int    @id @default(autoincrement())
  id_logger      String @db.VarChar(15)
  status_kontrol String @db.VarChar(5)
  session_id     String @db.VarChar(200)

  @@map("status_kontrol")
}

model SetTempkontrol {
  id            Int       @id @default(autoincrement())
  id_logger     String    @db.VarChar(15)
  set_value     String    @db.VarChar(10)
  status        String    @db.VarChar(5)
  status_manual String    @db.VarChar(5)
  datetime      DateTime?

  @@map("set_tempkontrol")
}

model LogSiaga {
  id        Int    @id @default(autoincrement())
  id_logger String @db.VarChar(15)
  nilai     Float
  status    String @db.VarChar(20)
  waktu     String @db.VarChar(100)

  @@map("log_siaga")
}

// =============================================
// CONFIGURATION
// =============================================

model ConfigAdr {
  id          Int    @id @default(autoincrement())
  id_logger   Int
  job_name    String @db.VarChar(225)
  prisma_cons Float
  ts_high     Float
  coor_x      Float
  coor_y      Float
  coor_z      Float
  step_record Int
  retries     Int
  cycle_time  Int

  @@map("config_adr")
}

model Filter {
  id          Int    @id @default(autoincrement())
  id_kategori Int
  nama_filter String @db.VarChar(225)
  icon        String @db.VarChar(225)

  @@map("filter")
}

model ParameterSensor {
  id_param     Int    @id @default(autoincrement())
  logger_id    String @db.VarChar(15)
  nama_param   String @db.VarChar(225)
  kolom_sensor String @db.VarChar(25)
  satuan       String @db.VarChar(25)
  warna        String @db.VarChar(25)

  @@map("parameter_sensor")
}

model SetEws {
  id        Int    @id @default(autoincrement())
  id_logger String @db.VarChar(15)
  status1   String @db.VarChar(20)
  siaga1    Float
  siaga2    Float
  siaga3    Float

  @@map("set_ews")
}

model SchedulingTask {
  id        Int       @id @default(autoincrement())
  id_logger String    @db.VarChar(15)
  days      String    @db.VarChar(5)
  time      String    @db.VarChar(10)
  status    String    @db.VarChar(5)
  site      String?   @db.VarChar(225)
  datetime  DateTime?

  @@map("scheduling_task")
}

model Perbaikan {
  id_perbaikan  Int    @id @default(autoincrement())
  id_logger     String @db.VarChar(15)
  data_terakhir String @db.Text
  tabel         String @db.VarChar(15)

  @@map("t_perbaikan")
}
