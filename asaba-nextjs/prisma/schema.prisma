// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================
// AUTH & USER
// =============================================

model User {
  id_user    Int     @id @default(autoincrement())
  nama       String  @db.VarChar(100)
  username   String  @unique @db.VarChar(30)
  password   String  @db.VarChar(255)
  level_user String  @db.VarChar(20)
  alamat     String  @db.Text
  telp       String  @db.VarChar(25)
  instansi   String? @db.VarChar(50)
  latitude   String  @db.VarChar(225)
  longitude  String  @db.VarChar(225)
  zoom       Int     @default(10)
  bidang     String? @db.VarChar(100)

  @@map("t_user")
}

model KodeAkses {
  id              Int      @id @default(autoincrement())
  id_user         Int
  kode_akses      String   @db.VarChar(255)
  tanggal_mulai   DateTime @db.Date
  tanggal_selesai DateTime @db.Date

  @@map("kode_akses")
}

// =============================================
// LOGGER & LOKASI
// =============================================

model Logger {
  id            Int    @id @default(autoincrement())
  id_logger     String @db.VarChar(10)
  nama_logger   String @db.VarChar(30)
  lokasi_logger String @db.VarChar(30)
  kategori_log  String @db.VarChar(10)
  tabel         String @db.VarChar(10)

  @@map("t_logger")
}

model Lokasi {
  idlokasi    Int    @id @default(autoincrement())
  nama_lokasi String @db.VarChar(40)
  latitude    String @db.VarChar(20)
  longitude   String @db.VarChar(20)

  @@map("t_lokasi")
}

model KategoriLogger {
  id_katlogger  Int    @id @default(autoincrement())
  nama_kategori String @db.VarChar(30)
  controller    String @db.VarChar(20)
  tabel         String @db.VarChar(20)
  kepanjangan   String @db.Text
  temp_data     String @db.VarChar(20)
  icon_app      String @db.VarChar(25)
  view          Int    @default(1)

  @@map("kategori_logger")
}

model Informasi {
  id_inf        Int      @id @default(autoincrement())
  logger_id     String   @db.VarChar(10)
  seri          String   @db.Text
  sensor        String   @db.Text
  serial_number String   @db.VarChar(25)
  elevasi       String   @db.VarChar(10)
  nosell        String   @db.VarChar(15)
  nama_pic      String   @db.VarChar(25)
  no_pic        String   @db.VarChar(15)
  tgl_aktif     String   @db.VarChar(10)
  garansi       String   @db.VarChar(10)
  tgl_kontrak   String   @db.VarChar(10)
  imei          String   @db.VarChar(20)
  masa_aktif    DateTime @db.Date

  @@map("t_informasi")
}

// =============================================
// PRISMA (TARGET POINTS)
// =============================================

model PrismaTarget {
  id                Int     @id @default(autoincrement())
  id_prisma         String  @db.VarChar(11)
  id_logger         Int
  nama_prisma       String  @db.VarChar(255)
  status_controller String  @db.VarChar(25)
  target_height     Float   @default(0)
  HA                String? @default("0") @db.VarChar(200)
  VA                String? @default("0") @db.VarChar(200)
  SlopDis           Float?  @default(0)

  @@map("t_prisma")
}

model TempPrisma {
  id_prisma   String @id @db.VarChar(25)
  code_logger String @db.VarChar(10)
  sensor1     String @db.VarChar(200)
  sensor2     String @db.VarChar(200)
  sensor3     String @db.VarChar(200)
  sensor4     String @db.VarChar(200)
  sensor5     String @db.VarChar(200)
  sensor6     String @db.VarChar(200)
  sensor7     String @db.VarChar(200)
  sensor8     String @db.VarChar(200)
  sensor9     String @db.VarChar(200)
  nama        String @db.VarChar(200)
  status_get  Int    @default(0)

  @@map("temp_prisma")
}

model ParameterPrisma {
  id_param     Int    @id @default(autoincrement())
  id_prisma    String @db.VarChar(11)
  nama_param   String @db.VarChar(225)
  kolom_sensor String @db.VarChar(25)
  satuan       String @db.VarChar(25)
  id_logger    String @db.VarChar(15)

  @@map("parameter_prisma")
}

