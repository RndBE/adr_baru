  waktu     String @db.VarChar(100)

  @@map("log_siaga")
}

model ConfigAdr {
  id          Int    @id @default(autoincrement())
  id_logger   Int
  job_name    String @db.VarChar(225)
  prisma_cons Float  @db.Float
  ts_high     Float  @db.Float
  coor_x      Float  @db.Float
  coor_y      Float  @db.Float
  coor_z      Float  @db.Float
