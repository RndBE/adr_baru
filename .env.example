# MQTT Configuration (Beacon Telemetry)
MQTT_HOST="mqtt.beacontelemetry.com"
MQTT_PORT="8883"
MQTT_USERNAME="userlog"
MQTT_PASSWORD="b34c0n"
# Topik tidak disetel di sini: protokol memakai sub_<idAlat> untuk perintah dan
# pub_<idAlat> untuk balasan, polanya ter-hardcode di firmware.
# Lihat topikPerintah()/topikBalasan() di asaba-nextjs/src/lib/mqtt.ts.
# Set ke "true" di production untuk enforce TLS certificate verification
MQTT_REJECT_UNAUTHORIZED="false"

# ------------------------------------------------------------
# Peringatan pergeseran (asaba-nextjs/src/lib/kirim-peringatan.ts)
# ------------------------------------------------------------
# Dua kanal, keduanya opsional dan berdiri sendiri. Selama keduanya kosong
# evaluasi tetap berjalan dan tetap mencatat ke log_peringatan — hanya
# pengirimannya yang dicatat gagal. Cukup SATU kanal berhasil untuk menandai
# sebuah peringatan terkirim.

# Telegram — bikin bot lewat @BotFather, lalu ambil chat id grupnya.
# TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
# Cadangan untuk site yang belum punya chat sendiri:
# TELEGRAM_CHAT_ID="-1001234567890"
# Per site — akhiran = nama site, huruf besar, non-alfanumerik jadi "_":
# TELEGRAM_CHAT_ID_CCP="-1001234567890"

# Email — SMTP kotak surat yang sudah ada; tidak perlu mendaftar layanan baru.
# Port 465 = TLS dari awal, 587 = STARTTLS. SMTP_SECURE diturunkan dari port,
# isi hanya kalau server Anda menyimpang dari itu.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="peringatan@instansi.go.id"
# SMTP_PASS="app-password-16-karakter"
# SMTP_SECURE="false"
# Alamat pengirim. Kosong = ikut SMTP_USER, karena banyak relay menolak From
# yang bukan akun yang login.
# ALERT_EMAIL_FROM="Peringatan ADR <peringatan@instansi.go.id>"
# Penerima. Pemisahnya boleh koma, titik koma, atau spasi. Akhiran per site
# mengikuti aturan yang sama dengan TELEGRAM_CHAT_ID_*.
# ALERT_EMAIL_TO="kepala@instansi.go.id, teknisi@instansi.go.id"
# ALERT_EMAIL_TO_CCP="pengawas.ccp@instansi.go.id"

# WhatsApp — lewat wwebjs-api di Server 3 (pembungkus REST whatsapp-web.js).
# Dokumentasi lengkap: be-server/docs/servers/server-3-wwebjs-api.md
# Ambil API key: ssh server3 'grep ^API_KEY /root/wwebjs-api/.env'
# Sesi harus sudah di-scan QR-nya di server; cek dengan
#   curl -H "x-api-key: $KEY" http://72.60.78.159:3000/session/status/beacon
# WHATSAPP_API_URL="http://72.60.78.159:3000"
# WHATSAPP_API_KEY="<64 hex dari .env server>"
# WHATSAPP_SESSION="beacon"
# Tujuan. Boleh nomor (0812…, +62812…, 62812…) atau id grup (…@g.us).
# Grup lebih dianjurkan: satu panggilan API untuk seluruh piket, dan daftar
# orangnya diurus di WhatsApp, bukan lewat redeploy.
# WHATSAPP_TO="120363012345678901@g.us"
# WHATSAPP_TO_CCP="081288888888, 081277777777"
